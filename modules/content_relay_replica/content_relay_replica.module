<?php

/**
 * @file
 * Hook implementations for Content Relay Replica.
 */

declare(strict_types=1);

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;

/**
 * Implements hook_cron().
 */
function content_relay_replica_cron(): void {
  \Drupal::service('content_relay_replica.subscription')->sendPendingProposal();
  \Drupal::service('content_relay_replica.failed_events')->scheduleDueRetries();
  \Drupal::service('content_relay_replica.processed_events')->prune();
  \Drupal::service('content_relay_replica.origin_client')->sendPending();
  \Drupal::service('content_relay_replica.schema_watcher')->checkIfDue();
  $reconciler = \Drupal::service('content_relay_replica.reconciler');
  $reconciler->fillGaps();
  $reconciler->cron();
  // Queued events whose queue item went missing, after an hour.
  \Drupal::service('content_relay_replica.received_events')->requeueStale(3600);
  $files = \Drupal::service('content_relay_replica.file_sync');
  $files->scheduleDue();
  // A periodic check that every synced file is here and intact.
  $interval = (int) \Drupal::config('content_relay_replica.settings')->get('files.verify_interval');
  $state = \Drupal::state();
  if ($interval > 0 && \Drupal::time()->getRequestTime() - (int) $state->get('content_relay_replica.files_verified', 0) >= $interval) {
    $files->verifyAll();
    $state->set('content_relay_replica.files_verified', \Drupal::time()->getRequestTime());
  }
}

/**
 * Implements hook_entity_translation_insert().
 */
function content_relay_replica_entity_translation_insert(EntityInterface $translation): void {
  _content_relay_replica_translations_changed($translation);
}

/**
 * Implements hook_entity_translation_delete().
 */
function content_relay_replica_entity_translation_delete(EntityInterface $translation): void {
  _content_relay_replica_translations_changed($translation);
}

/**
 * Keeps the local translations of a synced item listed, after a change here.
 */
function _content_relay_replica_translations_changed(EntityInterface $translation): void {
  // Sync records them itself when it applies.
  if ($translation instanceof ContentEntityInterface && !$translation->isSyncing() && $translation->uuid() !== NULL) {
    \Drupal::service('content_relay_replica.language_subscription')->refreshLocalTranslations($translation->getEntityTypeId(), (string) $translation->uuid());
  }
}

/**
 * Implements hook_entity_operation().
 */
function content_relay_replica_entity_operation(EntityInterface $entity, ?CacheableMetadata $cacheability = NULL): array {
  $cacheability?->addCacheContexts(['user.permissions']);
  return \Drupal::service('content_relay_replica.entity_ui')->operations($entity);
}

/**
 * Implements hook_help().
 */
function content_relay_replica_help(string $route_name, RouteMatchInterface $route_match): ?string {
  return match ($route_name) {
    'help.page.content_relay_replica' => '<p>' . t('This site is a Content Relay replica. <a href=":pair">Pair it</a> with an origin, choose what it receives on the <a href=":subscription">subscription</a> page, and how it applies it in the <a href=":settings">settings</a>. The <a href=":report">synced items</a> report shows each item\'s state; content created on this site is never touched by sync.', [
      ':pair' => Url::fromRoute('content_relay_replica.pair')->toString(),
      ':subscription' => Url::fromRoute('content_relay_replica.subscription')->toString(),
      ':settings' => Url::fromRoute('content_relay_replica.settings')->toString(),
      ':report' => Url::fromUserInput('/admin/reports/content-relay/received')->toString(),
    ]) . '</p>',
    'content_relay_replica.subscription' => '<p>' . t('Changes are proposed to the origin, which answers with a new contract version. Until it confirms, the current contract stays in force.') . '</p>',
    'content_relay_replica.settings' => '<p>' . t('How received content is applied here. What is received is set on the subscription page.') . '</p>',
    'content_relay_replica.reconcile' => '<p>' . t('Reconciliation compares every received item with the origin and fixes what differs. It never touches content made here, items detached here, or items in conflict.') . '</p>',
    'view.content_relay_replica_report.page_1' => '<p>' . t('Items received from the origin. Use the operations to pull, resolve a conflict, validate, detach or reattach; select several to detach or reattach them together.') . '</p>',
    default => NULL,
  };
}

/**
 * Implements hook_page_top().
 *
 * On administration pages, tells those who can act on it that synced items
 * failed to save.
 */
function content_relay_replica_page_top(array &$page_top): void {
  $account = \Drupal::currentUser();
  if (!\Drupal::service('router.admin_context')->isAdminRoute() || !$account->hasPermission('pull content relay items')) {
    return;
  }
  $page_top['#cache']['contexts'][] = 'user.permissions';
  $page_top['#cache']['tags'][] = 'content_relay_failures';
  $open = \Drupal::service('content_relay_replica.failed_events')->countOpen();
  if ($open === 0 || \Drupal::routeMatch()->getRouteName() === 'content_relay_replica.failures') {
    return;
  }
  $page_top['content_relay_failures'] = [
    '#theme' => 'status_messages',
    '#message_list' => [
      'warning' => [
        \Drupal::translation()->formatPlural($open, '1 synced item failed to save. <a href=":url">Review it</a>.', '@count synced items failed to save. <a href=":url">Review them</a>.', [
          ':url' => Url::fromRoute('content_relay_replica.failures')->toString(),
        ]),
      ],
    ],
    '#status_headings' => ['warning' => t('Warning message')],
  ];
}
