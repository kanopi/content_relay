<?php

/**
 * @file
 * Install, update and uninstall functions for Content Relay Replica.
 */

declare(strict_types=1);

use Drupal\content_relay_replica\ContractStore;
use Drupal\content_relay_replica\FailedEventStore;
use Drupal\content_relay_replica\File\FileSync;
use Drupal\content_relay_replica\Processing\ReceivedEvents;
use Drupal\content_relay_replica\ProcessedEvents;
use Drupal\content_relay_replica\Reconciler;
use Drupal\content_relay_replica\StreamTracker;
use Drupal\content_relay_replica\SyncStateStore;
use Drupal\Core\Serialization\Yaml;
use Drupal\Core\Url;

/**
 * Implements hook_requirements().
 */
function content_relay_replica_requirements(string $phase): array {
  $requirements = [];
  if ($phase === 'install' && \Drupal::moduleHandler()->moduleExists('content_relay_origin')) {
    $requirements['content_relay_replica_role'] = [
      'title' => t('Content Relay role'),
      'description' => t('Content Relay Origin is enabled. A site can be an origin or a replica, not both.'),
      'severity' => REQUIREMENT_ERROR,
    ];
  }
  if ($phase === 'runtime') {
    $schema = \Drupal::service('content_relay_replica.schema_watcher')->problems();
    $requirements['content_relay_replica_schema'] = [
      'title' => t('Content Relay origin schema'),
      'value' => $schema === [] ? t('Every received bundle fits this site') : t('Bundles that do not fit: @bundles', ['@bundles' => implode(', ', array_keys($schema))]),
      'description' => $schema === [] ? '' : implode(' ', array_merge(...array_values($schema))),
      'severity' => $schema === [] ? REQUIREMENT_OK : REQUIREMENT_WARNING,
    ];
    $open = \Drupal::service('content_relay_replica.failed_events')->countOpen();
    $requirements['content_relay_replica_failures'] = [
      'title' => t('Content Relay synced items'),
      'value' => $open ? \Drupal::translation()->formatPlural($open, '1 synced item failed to save', '@count synced items failed to save') : t('No save failures'),
      'description' => $open ? t('<a href=":url">Review and retry them</a>.', [':url' => Url::fromRoute('content_relay_replica.failures')->toString()]) : '',
      'severity' => $open ? REQUIREMENT_WARNING : REQUIREMENT_OK,
    ];
  }
  return $requirements;
}

/**
