        'type' => 'text',
        'not null' => TRUE,
        'description' => 'JSON: origin langcode => hash, as received.',
      ],
      'local_hash' => [
        'type' => 'char',
        'length' => 64,
        'not null' => FALSE,
        'description' => 'Hash of the local copy, computed after applying.',
      ],
      'local_translation_hashes' => [
        'type' => 'text',
        'not null' => FALSE,
        'description' => 'JSON: langcode => hash of each translation of the local copy, computed after applying.',
