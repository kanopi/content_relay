/**
 * Renames the contract table, and creates tables a failed install left out.
 *
 * The contract table was content_relay_contract, as the origin's is, so a site
 * could not have both roles; an install of the second role stopped there.
 */
function content_relay_replica_update_10001(): string {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists(ContractStore::TABLE) && $schema->tableExists('content_relay_contract') && !$schema->fieldExists('content_relay_contract', 'replica_id')) {
    $schema->renameTable('content_relay_contract', ContractStore::TABLE);
  }
  $created = [];
  foreach (content_relay_replica_schema() as $table => $definition) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $definition);
      $created[] = $table;
    }
  }
  return $created === [] ? (string) t('The replica keeps its contracts in their own table.') : (string) t('Created missing tables: @tables.', ['@tables' => implode(', ', $created)]);
}

/**
 * Adds the origin pairing configuration entity type.
 */
function content_relay_replica_update_10002(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if ($manager->getEntityType('content_relay_origin_pairing') === NULL) {
    $manager->installEntityType(\Drupal::entityTypeManager()->getDefinition('content_relay_origin_pairing'));
  }
  return (string) t('Each origin a site receives from now has its own receiving settings.');
}

/**
 * Keeps each origin pairing's contracts apart.
 */
function content_relay_replica_update_10003(): string {
  $schema = \Drupal::database()->schema();
  if (!$schema->fieldExists(ContractStore::TABLE, 'pairing')) {
    $schema->addField(ContractStore::TABLE, 'pairing', content_relay_replica_schema()[ContractStore::TABLE]['fields']['pairing']);
    $schema->dropPrimaryKey(ContractStore::TABLE);
    $schema->addPrimaryKey(ContractStore::TABLE, ['pairing', 'version']);
  }
  return (string) t('Contracts are kept per origin pairing.');
}

/**
 * Records which origin pairing reconciliation runs and files belong to.
 */
function content_relay_replica_update_10004(): string {
  $schema = \Drupal::database()->schema();
  $definitions = content_relay_replica_schema();
  foreach ([Reconciler::TABLE, FileSync::TABLE] as $table) {
    if (!$schema->fieldExists($table, 'pairing')) {
      $schema->addField($table, 'pairing', $definitions[$table]['fields']['pairing']);
    }
  }
  return (string) t('Reconciliation runs and files record their origin pairing.');
}

/**
 * Adds the origin column and filter to the synced items report.
 */
function content_relay_replica_update_10005(): string {
  $config = \Drupal::configFactory()->getEditable('views.view.content_relay_replica_report');
  if ($config->isNew() || $config->get('display.default.display_options.fields.source_site') !== NULL) {
    return (string) t('Nothing to do.');
  }
  $shipped = Yaml::decode((string) file_get_contents(__DIR__ . '/config/install/views.view.content_relay_replica_report.yml'));
  $options = $shipped['display']['default']['display_options'];
  foreach (['fields', 'filters'] as $type) {
    $config->set("display.default.display_options.$type", _content_relay_replica_insert_after(
      $config->get("display.default.display_options.$type") ?? [],
      'bundle',
      ['source_site' => $options[$type]['source_site']],
    ));
  }
  $config->set('display.default.display_options.style.options.columns.source_site', 'source_site');
  $config->set('display.default.display_options.style.options.info.source_site', $options['style']['options']['info']['source_site']);
  $config->save();
  return (string) t('The synced items report shows and filters by origin.');
}

/**
 * Inserts entries after a key, or at the end without it.
 */
function _content_relay_replica_insert_after(array $array, string $after, array $insert): array {
  $position = array_search($after, array_keys($array), TRUE);
  if ($position === FALSE) {
    return $array + $insert;
  }
  return array_slice($array, 0, $position + 1, TRUE) + $insert + array_slice($array, $position + 1, NULL, TRUE);
}
