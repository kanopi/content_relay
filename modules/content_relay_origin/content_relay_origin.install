      'not_syncable' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
      'detached_by' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'detached_at' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'last_event' => [
        'type' => 'int',
        'size' => 'big',
        'unsigned' => TRUE,
        'not null' => FALSE,
        'description' => 'The latest event log row for the item and replica.',
      ],
      'last_attempt' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'last_success' => ['type' => 'int', 'size' => 'big', 'not null' => FALSE],
      'last_error' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'unresolved_files' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Links to files that could not be resolved on the origin.',
      ],
      'changed' => [
        'type' => 'int',
        'size' => 'big',
