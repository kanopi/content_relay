      'status' => ['type' => 'varchar_ascii', 'length' => 16, 'not null' => TRUE, 'default' => 'active'],
      'signing_keys' => [
        'type' => 'text',
        'not null' => TRUE,
        'description' => 'JSON: key ID => {public_key, status}.',
      ],
      'encryption_keys' => [
        'type' => 'text',
        'not null' => TRUE,
        'description' => 'JSON: key ID => {public_key, status}.',
