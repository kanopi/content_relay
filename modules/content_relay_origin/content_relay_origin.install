    'indexes' => [
      'status' => ['replica_id', 'status'],
      'bundle' => ['entity_type', 'bundle'],
      'entity' => ['entity_type', 'entity_id'],
      'changed' => ['changed'],
      'status_changed' => ['status', 'changed'],
      'out_of_sync_changed' => ['item_out_of_sync', 'changed'],
      'bundle_changed' => ['bundle', 'changed'],
    ],
  ];
  return $schema;
