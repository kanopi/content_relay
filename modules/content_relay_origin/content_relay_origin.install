/**
 * Implements hook_update_dependencies().
 */
function content_relay_origin_update_dependencies(): array {
  // The replica first moves its contract table out of the origin's way.
  return ['content_relay_origin' => [10001 => ['content_relay_replica' => 10001]]];
}

/**
 * Creates tables a failed install left out.
 *
 * Installing the origin on a replica stopped at the contract table, which
 * both roles named alike.
 */
function content_relay_origin_update_10001(): string {
  $schema = \Drupal::database()->schema();
  $created = [];
  foreach (content_relay_origin_schema() as $table => $definition) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $definition);
      $created[] = $table;
    }
  }
  return $created === [] ? (string) t('Nothing to do.') : (string) t('Created missing tables: @tables.', ['@tables' => implode(', ', $created)]);
}

/**
 * Adds the status report's indexes for its main filters and order.
 */
function content_relay_origin_update_10002(): string {
  $schema = \Drupal::database()->schema();
  $definition = content_relay_origin_schema()[ReportIndex::TABLE];
  $added = [];
  foreach ($definition['indexes'] as $name => $fields) {
    if (!$schema->indexExists(ReportIndex::TABLE, $name)) {
      $schema->addIndex(ReportIndex::TABLE, $name, $fields, $definition);
      $added[] = $name;
    }
  }
  return $added === [] ? (string) t('Nothing to do.') : (string) t('Added indexes: @indexes.', ['@indexes' => implode(', ', $added)]);
}

/**
 * Installs per-replica sending settings.
 */
function content_relay_origin_update_10003(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if ($manager->getEntityType('content_relay_replica_pairing') === NULL) {
    $manager->installEntityType(\Drupal::entityTypeManager()->getDefinition('content_relay_replica_pairing'));
  }
  return (string) t('Each replica can now have its own sending settings.');
}

/**
 * Renames "not syncable" to "stop syncing" where editors see it.
 */
function content_relay_origin_update_10004(): string {
  $config_factory = \Drupal::configFactory();
  $labels = [
    'system.action.content_relay_node_not_syncable' => [
      'Mark not syncable (Content Relay)',
      'Stop syncing (Content Relay)',
    ],
    'system.action.content_relay_node_syncable' => ['Make syncable (Content Relay)', 'Resume syncing (Content Relay)'],
  ];
  $renamed = [];
  foreach ($labels as $name => [$old, $new]) {
    $config = $config_factory->getEditable($name);
    if (!$config->isNew() && $config->get('label') === $old) {
      $config->set('label', $new)->save();
      $renamed[] = $name;
    }
  }
  $view = $config_factory->getEditable('views.view.content_relay_origin_report');
  $field = 'display.default.display_options.fields.not_syncable.label';
  if (!$view->isNew() && $view->get($field) === 'Not syncable') {
    $view->set($field, 'Syncing stopped')->save();
    $renamed[] = $view->getName();
  }
  return $renamed === [] ? (string) t('Nothing to do.') : (string) t('Renamed in: @names.', ['@names' => implode(', ', $renamed)]);
}
