<?php

/**
 * @file
 * Install, update and uninstall functions for Content Relay Origin.
 */

declare(strict_types=1);

use Drupal\content_relay_origin\ContractManager;
use Drupal\content_relay_origin\HashStore;
use Drupal\content_relay_origin\NotSyncableFlags;
use Drupal\content_relay_origin\Outbox;
use Drupal\content_relay_origin\PairingCodes;
use Drupal\content_relay_origin\ReplicaItems;
use Drupal\content_relay_origin\ReplicaRegistry;
use Drupal\content_relay_origin\TranslationBlocks;
use Drupal\content_relay_origin\Report\ReportIndex;

/**
 * Implements hook_requirements().
 */
function content_relay_origin_requirements(string $phase): array {
  $requirements = [];
  // One site is either the source of truth or a copy of one. Both at once
  // would let a replica republish what it received, which is two-way sync.
  if ($phase === 'install' && \Drupal::moduleHandler()->moduleExists('content_relay_replica')) {
    $requirements['content_relay_origin_role'] = [
      'title' => t('Content Relay role'),
      'description' => t('Content Relay Replica is enabled. A site can be an origin or a replica, not both.'),
      'severity' => REQUIREMENT_ERROR,
    ];
  }
  return $requirements;
}

