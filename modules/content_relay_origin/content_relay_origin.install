      'contract_version' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'The acknowledged contract version in force; 0 before the first acknowledgement.',
      ],
      'next_sequence' => ['type' => 'int', 'size' => 'big', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 1],
      'created' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0],
      'changed' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0],
