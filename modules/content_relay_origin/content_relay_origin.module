<?php

/**
 * @file
 * Hook implementations for Content Relay Origin.
 */

declare(strict_types=1);

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_entity_insert().
 */
function content_relay_origin_entity_insert(EntityInterface $entity): void {
  \Drupal::service('content_relay_origin.change_recorder')->onSave($entity, TRUE);
}

/**
 * Implements hook_entity_update().
 */
function content_relay_origin_entity_update(EntityInterface $entity): void {
  \Drupal::service('content_relay_origin.change_recorder')->onSave($entity, FALSE);
}

/**
 * Implements hook_entity_delete().
 */
function content_relay_origin_entity_delete(EntityInterface $entity): void {
  \Drupal::service('content_relay_origin.change_recorder')->onDelete($entity);
}

/**
 * Implements hook_cron().
 */
function content_relay_origin_cron(): void {
  \Drupal::service('content_relay_origin.contract_manager')->pushPending();
  \Drupal::service('content_relay_origin.pairing_codes')->prune();
  \Drupal::service('content_relay_origin.delivery_scheduler')->scheduleDue();
  \Drupal::service('content_relay_origin.status_poller')->pollAll();
  \Drupal::service('content_relay_origin.outbox')->prune();
  \Drupal::service('content_relay_origin.report_rebuild')->rebuildIfChanged();
  \Drupal::service('content_relay_origin.reconciler')->cron();
}

/**
 * Implements hook_entity_operation().
 */
function content_relay_origin_entity_operation(EntityInterface $entity, ?CacheableMetadata $cacheability = NULL): array {
  $cacheability?->addCacheContexts(['user.permissions']);
  return \Drupal::service('content_relay_origin.entity_ui')->operations($entity);
}

/**
 * Implements hook_form_alter().
 */
function content_relay_origin_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  \Drupal::service('content_relay_origin.entity_ui')->formAlter($form, $form_state);
}
