<?php

/**
 * @file
 * Hook implementations for Content Relay Origin.
 */

declare(strict_types=1);

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;
use Drupal\language\ConfigurableLanguageInterface;

/**
 * Implements hook_entity_insert().
 */
function content_relay_origin_entity_insert(EntityInterface $entity): void {
  \Drupal::service('content_relay_origin.change_recorder')->onSave($entity, TRUE);
}

/**
 * Implements hook_entity_update().
 */
function content_relay_origin_entity_update(EntityInterface $entity): void {
  \Drupal::service('content_relay_origin.change_recorder')->onSave($entity, FALSE);
}

/**
 * Implements hook_entity_delete().
 */
function content_relay_origin_entity_delete(EntityInterface $entity): void {
  \Drupal::service('content_relay_origin.change_recorder')->onDelete($entity);
}

/**
 * Implements hook_cron().
 */
function content_relay_origin_cron(): void {
  \Drupal::service('content_relay_origin.contract_manager')->pushPending();
  \Drupal::service('content_relay_origin.pairing_codes')->prune();
  \Drupal::service('content_relay_origin.delivery_scheduler')->scheduleDue();
  \Drupal::service('content_relay_origin.status_poller')->pollAll();
  \Drupal::service('content_relay_origin.outbox')->prune();
  \Drupal::service('content_relay_origin.report_rebuild')->rebuildIfChanged();
  \Drupal::service('content_relay_origin.reconciler')->cron();
  \Drupal::service('content_relay_origin.language_notices')->sendPending();
}

/**
 * Implements hook_ENTITY_TYPE_insert() for configurable_language.
 */
function content_relay_origin_configurable_language_insert(ConfigurableLanguageInterface $language): void {
  if (!$language->isLocked() && !$language->isSyncing()) {
    \Drupal::service('content_relay_origin.language_notices')->notify('added', $language->getId(), $language->getName());
  }
}

/**
 * Implements hook_ENTITY_TYPE_delete() for configurable_language.
 */
function content_relay_origin_configurable_language_delete(ConfigurableLanguageInterface $language): void {
  if (!$language->isLocked() && !$language->isSyncing()) {
    \Drupal::service('content_relay_origin.language_notices')->notify('removed', $language->getId(), $language->getName());
  }
}

/**
 * Implements hook_entity_operation().
 */
function content_relay_origin_entity_operation(EntityInterface $entity, ?CacheableMetadata $cacheability = NULL): array {
  $cacheability?->addCacheContexts(['user.permissions']);
  return \Drupal::service('content_relay_origin.entity_ui')->operations($entity);
}

/**
 * Implements hook_form_alter().
 */
function content_relay_origin_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  \Drupal::service('content_relay_origin.entity_ui')->formAlter($form, $form_state);
}

/**
 * Implements hook_help().
 */
function content_relay_origin_help(string $route_name, RouteMatchInterface $route_match): ?string {
  return match ($route_name) {
    'help.page.content_relay_origin' => '<p>' . t('This site is a Content Relay origin. Choose the bundles to publish in the <a href=":settings">settings</a>, give a replica a <a href=":code">pairing code</a>, and follow what each replica has in the <a href=":report">status report</a> and the <a href=":log">event log</a>. Saving content records an event for each replica; cron and the queue deliver them in order, with retries.', [
      ':settings' => Url::fromRoute('content_relay_origin.settings')->toString(),
      ':code' => Url::fromRoute('content_relay_origin.pairing_code')->toString(),
      ':report' => Url::fromUserInput('/admin/reports/content-relay')->toString(),
      ':log' => Url::fromUserInput('/admin/reports/content-relay/events')->toString(),
    ]) . '</p>',
    'content_relay_origin.replicas' => '<p>' . t('Sites paired with this origin. Approve new ones when approval is required, suspend delivery, or revoke a replica for good. Its contract says what it gets.') . '</p>',
    'content_relay_origin.pairing_code' => '<p>' . t("A code is shown once and works once, for a limited time. Give it to the replica's administrator with this site's address.") . '</p>',
    'view.content_relay_origin_events.page_1' => '<p>' . t("Every event for every replica. Failed and dead-lettered events can be replayed: the item's current version is sent again.") . '</p>',
    'view.content_relay_origin_report.page_1' => '<p>' . t("One row per item, translation and replica. Select rows to push them, or push everything matching the filters. Out of sync means the replica's acknowledged hash differs from this site's latest.") . '</p>',
    default => NULL,
  };
}
